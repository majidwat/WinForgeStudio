import { Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "WinForge Studio";
    width: 1000px;
    height: 700px;
    background: #10151d;
    in-out property <string> os_name: "Windows";
    in-out property <string> os_version: "—";
    in-out property <string> hostname: "—";
    in-out property <string> uptime: "—";
    in-out property <string> process_count: "—";
    in-out property <string> top_processes: "—";
    in-out property <string> startup_count: "—";
    in-out property <string> startup_items: "—";
    in-out property <string> cpu_name: "CPU";
    in-out property <string> cpu_count: "—";
    in-out property <string> ram_total: "—";
    in-out property <string> ram_used: "—";
    in-out property <string> ram_percent: "—";
    in-out property <int> active_page: 0;
    callback refresh-requested();

    Rectangle { background: #10151d; }
    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 220px;
            background: #151d28;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "WINFORGE"; color: #f4f6f9; font-size: 20px; font-weight: 700; }
                Text { text: "STUDIO / SYSTEM UTILITY"; color: #8191a6; font-size: 10px; }
                Rectangle { height: 1px; background: #283443; }
                for item in [{name: "Dashboard", id: 0}, {name: "System", id: 1}, {name: "Processes", id: 2}, {name: "Services", id: 3}, {name: "Startup", id: 4}, {name: "Network", id: 5}, {name: "Storage", id: 6}, {name: "Privacy", id: 7}, {name: "Settings", id: 8}] : Rectangle {
                    height: 38px;
                    border-radius: 7px;
                    background: active_page == item.id ? #25364a : #151d28;
                    Text { text: item.name; color: #e5edf7; vertical-alignment: center; }
                    TouchArea { clicked => { active_page = item.id; } }
                }
                Rectangle { }
            }
        }
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            HorizontalLayout {
                Text { text: active_page == 0 ? "Dashboard" : active_page == 1 ? "System Information" : "System Module"; color: #f4f6f9; font-size: 24px; font-weight: 700; }
                Rectangle { }
                Button { text: "Refresh"; clicked => { refresh-requested(); } }
            }
            if active_page == 0: VerticalLayout {
                spacing: 12px;
                Rectangle { height: 100px; border-radius: 10px; background: #1a2a3c; VerticalLayout { padding: 18px; Text { text: "Welcome to WinForge Studio"; color: #f1f5fa; font-size: 21px; font-weight: 700; } Text { text: "A modern, lightweight workspace for Windows."; color: #9fb0c4; font-size: 13px; } } }
                Rectangle { height: 110px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; Text { text: "RAM USED"; color: #8396ad; font-size: 11px; } Text { text: ram_used; color: #f0f4f9; font-size: 22px; font-weight: 700; } Text { text: ram_percent + " / " + ram_total; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 110px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; Text { text: "CPU CORES"; color: #8396ad; font-size: 11px; } Text { text: cpu_count; color: #f0f4f9; font-size: 22px; font-weight: 700; } Text { text: cpu_name; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 110px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; Text { text: "OPERATING SYSTEM"; color: #8396ad; font-size: 11px; } Text { text: os_name + " " + os_version; color: #f0f4f9; font-size: 20px; font-weight: 700; } } }
            }
            if active_page == 1: VerticalLayout {
                spacing: 10px;
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "Operating system"; color: #8396ad; font-size: 11px; } Text { text: os_name + " " + os_version; color: #f0f4f9; font-size: 17px; } } }
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "Device name"; color: #8396ad; font-size: 11px; } Text { text: hostname; color: #f0f4f9; font-size: 17px; } } }
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "Processor"; color: #8396ad; font-size: 11px; } Text { text: cpu_name; color: #f0f4f9; font-size: 17px; } Text { text: cpu_count + " logical processors"; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "Memory"; color: #8396ad; font-size: 11px; } Text { text: ram_used + " used of " + ram_total; color: #f0f4f9; font-size: 17px; } Text { text: ram_percent + " utilization"; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "System uptime"; color: #8396ad; font-size: 11px; } Text { text: uptime; color: #f0f4f9; font-size: 17px; } } }
            }
            if active_page == 2: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 20px; spacing: 12px; Text { text: "Running processes · " + process_count; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "Top processes by memory usage (read-only snapshot)"; color: #9fb0c4; font-size: 12px; } Text { text: top_processes; color: #d6e0eb; font-size: 13px; } } }
            if active_page == 4: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 20px; spacing: 12px; Text { text: "Startup entries · " + startup_count; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "Read-only inventory from Run and RunOnce registry keys. No changes are made."; color: #9fb0c4; font-size: 12px; } Text { text: startup_items; color: #d6e0eb; font-size: 12px; } } }
            if active_page > 2 && active_page != 4: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 24px; spacing: 12px; Text { text: "Coming soon"; color: #edf3fa; font-size: 18px; font-weight: 700; } Text { text: "This module will be implemented with safety checks and restore support."; color: #9fb0c4; font-size: 13px; } Button { text: "Back to Dashboard"; clicked => { active_page = 0; } } } }
            Rectangle { }
            Text { text: "PREVIEW BUILD · Rust / Slint"; color: #697b91; font-size: 10px; }
        }
    }
}

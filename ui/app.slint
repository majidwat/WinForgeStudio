import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "WinForge Studio";
    width: 1000px;
    height: 700px;
    background: #10151d;
    in-out property <string> os_name: "Windows";
    in-out property <string> os_version: "—";
    in-out property <string> hostname: "—";
    in-out property <string> uptime: "—";
    in-out property <string> process_count: "—";
    in-out property <string> top_processes: "—";
    in-out property <string> startup_count: "—";
    in-out property <string> startup_items: "—";
    in-out property <string> startup_filter: "";
    in-out property <string> service_count: "—";
    in-out property <string> service_items: "—";
    in-out property <string> service_filter: "";
    callback service-filter-requested(string);
    in-out property <string> network_items: "—";
    in-out property <string> storage_items: "—";
    in-out property <string> apps_count: "—";
    in-out property <string> apps_items: "—";
    in-out property <string> drivers_count: "—";
    in-out property <string> drivers_items: "—";
    in-out property <string> tasks_count: "—";
    in-out property <string> tasks_items: "—";
    in-out property <string> events_count: "—";
    in-out property <string> events_items: "—";
    in-out property <string> updates_count: "—";
    in-out property <string> updates_items: "—";
    in-out property <string> firewall_count: "—";
    in-out property <string> firewall_items: "—";
    in-out property <string> restore_count: "—";
    in-out property <string> restore_items: "—";
    in-out property <string> restore_description: "WinForge Studio checkpoint";
    in-out property <bool> confirm_restore_create: false;
    in-out property <string> environment_count: "—";
    in-out property <string> environment_items: "—";
    in-out property <string> battery_count: "—";
    in-out property <string> battery_items: "—";
    in-out property <string> security_count: "—";
    in-out property <string> security_items: "—";
    in-out property <string> activation_count: "—";
    in-out property <string> activation_items: "—";
    in-out property <string> adapter_count: "—";
    in-out property <string> adapter_items: "—";
    in-out property <string> boot_count: "—";
    in-out property <string> boot_items: "—";
    in-out property <string> scan_status: "Starting scan…";
    in-out property <string> power_count: "—";
    in-out property <string> power_items: "—";
    in-out property <string> confirm_power_scheme: "";
    callback power-scheme-requested(string);
    in-out property <string> device_health_count: "—";
    in-out property <string> device_health_items: "—";
    in-out property <string> hardware_count: "—";
    in-out property <string> hardware_items: "—";
    in-out property <string> privacy_count: "—";
    in-out property <string> privacy_items: "—";
    in-out property <string> health_summary: "Collecting health indicators…";
    in-out property <string> health_diagnostics_items: "No deep diagnostics have run yet.";
    in-out property <string> action_history_items: "No journal has been loaded yet.";
    callback action-history-refresh-requested();
    callback health-diagnostics-requested();
    in-out property <string> cleanup_count: "—";
    in-out property <string> cleanup_items: "Temporary folders have not been scanned yet.";
    in-out property <bool> confirm_cleanup: false;
    in-out property <string> report_content: "Report is not ready until the scan completes.";
    callback export-requested();
    in-out property <string> cpu_name: "CPU";
    in-out property <string> cpu_count: "—";
    in-out property <string> ram_total: "—";
    in-out property <string> ram_used: "—";
    in-out property <string> ram_percent: "—";
    in-out property <int> active_page: 0;
    callback refresh-requested();
    callback terminate-process-requested(string, string);
    callback service-action-requested(string, bool);
    callback service-start-mode-requested(string, string);
    in-out property <string> service_start_mode: "Manual";
    in-out property <bool> confirm_service_mode: false;
    callback startup-remove-requested(string, bool);
    callback startup-filter-requested(string);
    callback startup-restore-requested(string);
    callback startup-registry-restore-requested(string);
    callback network-flush-dns-requested();
    callback network-diagnostics-requested();
    callback app-uninstall-requested(string);
    callback app-filter-requested(string);
    callback cleanup-requested();
    callback restore-point-create-requested(string);
    in-out property <string> app_uninstall_name: "";
    in-out property <string> apps_filter: "";
    in-out property <bool> confirm_app_uninstall: false;
    in-out property <bool> confirm_dns_flush: false;
    in-out property <string> startup_backup_name: "";
    in-out property <string> startup_entry_name: "";
    in-out property <bool> confirm_startup_remove: false;
    in-out property <bool> startup_remove_registry: true;
    in-out property <string> service_name_text: "";
    in-out property <bool> confirm_service_action: false;
    in-out property <bool> service_action_start: true;
    in-out property <string> process_pid_text: "";
    in-out property <string> process_name_text: "";
    in-out property <bool> confirm_termination: false;

    Rectangle { background: #10151d; }
    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 220px;
            background: #151d28;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "WINFORGE"; color: #f4f6f9; font-size: 20px; font-weight: 700; }
                Text { text: "STUDIO / SYSTEM UTILITY"; color: #8191a6; font-size: 10px; }
                Rectangle { height: 1px; background: #283443; }
                ScrollView {
                    VerticalLayout {
                        spacing: 10px;
                                        for item in [{name: "Dashboard", id: 0}, {name: "System", id: 1}, {name: "Processes", id: 2}, {name: "Services", id: 3}, {name: "Startup", id: 4}, {name: "Network", id: 5}, {name: "Storage", id: 6}, {name: "Installed Apps", id: 7}, {name: "Drivers", id: 8}, {name: "Task Scheduler", id: 9}, {name: "Event Viewer", id: 10}, {name: "Windows Updates", id: 11}, {name: "Firewall", id: 12}, {name: "Restore Points", id: 13}, {name: "Environment", id: 14}, {name: "Security", id: 15}, {name: "Battery", id: 16}, {name: "Activation", id: 17}, {name: "Network Adapters", id: 18}, {name: "Boot Configuration", id: 19}, {name: "Power Plans", id: 20}, {name: "Device Health", id: 21}, {name: "Hardware", id: 22}, {name: "Privacy", id: 23}, {name: "Settings", id: 24}, {name: "Cleanup Preview", id: 25}, {name: "System Health Checks", id: 26}, {name: "Action History", id: 27}] : Rectangle {
                    height: 38px;
                    border-radius: 7px;
                    background: active_page == item.id ? #25364a : #151d28;
                    Text { text: item.name; color: #e5edf7; vertical-alignment: center; }
                    TouchArea { clicked => { active_page = item.id; } }
                }
                    }
                }
            }
        }
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            HorizontalLayout {
                Text { text: active_page == 0 ? "Dashboard" : active_page == 1 ? "System Information" : active_page == 2 ? "Processes" : active_page == 3 ? "Services" : active_page == 4 ? "Startup" : active_page == 5 ? "Network" : active_page == 6 ? "Storage" : active_page == 7 ? "Installed Apps" : active_page == 8 ? "Drivers" : active_page == 9 ? "Task Scheduler" : active_page == 10 ? "Event Viewer" : active_page == 11 ? "Windows Updates" : active_page == 12 ? "Firewall" : active_page == 13 ? "Restore Points" : active_page == 14 ? "Environment" : active_page == 15 ? "Security" : active_page == 16 ? "Battery" : active_page == 17 ? "Activation" : active_page == 18 ? "Network Adapters" : active_page == 19 ? "Boot Configuration" : active_page == 20 ? "Power Plans" : active_page == 21 ? "Device Health" : active_page == 22 ? "Hardware" : active_page == 23 ? "Privacy" : active_page == 24 ? "Settings" : active_page == 25 ? "Cleanup Preview" : active_page == 26 ? "System Health Checks" : active_page == 27 ? "Action History" : "System Module"; color: #f4f6f9; font-size: 24px; font-weight: 700; }
                Rectangle { }
                Button { text: "Refresh"; clicked => { refresh-requested(); } }
                Button { text: "Export report"; clicked => { export-requested(); } }
                Text { text: scan_status; color: #80b5ef; font-size: 11px; }
            }
            ScrollView {
                VerticalLayout {
                    spacing: 12px;
            if active_page == 0: VerticalLayout {
                spacing: 12px;
                Rectangle { height: 100px; border-radius: 10px; background: #1a2a3c; VerticalLayout { padding: 18px; Text { text: "Welcome to WinForge Studio"; color: #f1f5fa; font-size: 21px; font-weight: 700; } Text { text: "A modern, lightweight workspace for Windows."; color: #9fb0c4; font-size: 13px; } } }
                Rectangle { height: 110px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; Text { text: "RAM USED"; color: #8396ad; font-size: 11px; } Text { text: ram_used; color: #f0f4f9; font-size: 22px; font-weight: 700; } Text { text: ram_percent + " / " + ram_total; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 110px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; Text { text: "CPU CORES"; color: #8396ad; font-size: 11px; } Text { text: cpu_count; color: #f0f4f9; font-size: 22px; font-weight: 700; } Text { text: cpu_name; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 110px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; Text { text: "OPERATING SYSTEM"; color: #8396ad; font-size: 11px; } Text { text: os_name + " " + os_version; color: #f0f4f9; font-size: 20px; font-weight: 700; } } }
                Rectangle { height: 90px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; Text { text: "RUNNING PROCESSES"; color: #8396ad; font-size: 11px; } Text { text: process_count; color: #f0f4f9; font-size: 22px; font-weight: 700; } } }
                Rectangle { height: 90px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; Text { text: "DEVICE / UPTIME"; color: #8396ad; font-size: 11px; } Text { text: hostname; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: uptime; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 170px; border-radius: 10px; background: #1a222d; VerticalLayout { padding: 14px; spacing: 8px; Text { text: "QUICK HEALTH REVIEW"; color: #8396ad; font-size: 11px; } Text { text: health_summary; color: #d6e0eb; font-size: 12px; } } }
            }
            if active_page == 1: VerticalLayout {
                spacing: 10px;
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "Operating system"; color: #8396ad; font-size: 11px; } Text { text: os_name + " " + os_version; color: #f0f4f9; font-size: 17px; } } }
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "Device name"; color: #8396ad; font-size: 11px; } Text { text: hostname; color: #f0f4f9; font-size: 17px; } } }
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "Processor"; color: #8396ad; font-size: 11px; } Text { text: cpu_name; color: #f0f4f9; font-size: 17px; } Text { text: cpu_count + " logical processors"; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "Memory"; color: #8396ad; font-size: 11px; } Text { text: ram_used + " used of " + ram_total; color: #f0f4f9; font-size: 17px; } Text { text: ram_percent + " utilization"; color: #80b5ef; font-size: 12px; } } }
                Rectangle { height: 64px; border-radius: 8px; background: #1a222d; VerticalLayout { padding: 12px; Text { text: "System uptime"; color: #8396ad; font-size: 11px; } Text { text: uptime; color: #f0f4f9; font-size: 17px; } } }
            }
            if active_page == 2: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: "Running processes · " + process_count; color: #f0f4f9; font-size: 18px; font-weight: 700; }
                Text { text: "Find the exact PID and image name in the inventory below. Termination requires a second explicit confirmation."; color: #9fb0c4; font-size: 12px; }
                HorizontalLayout { spacing: 8px;
                    Text { text: "PID"; color: #d6e0eb; vertical-alignment: center; }
                    LineEdit { width: 110px; placeholder-text: "PID"; text <=> process_pid_text; }
                    Text { text: "Exact image name"; color: #d6e0eb; vertical-alignment: center; }
                    LineEdit { width: 180px; placeholder-text: "e.g. app.exe"; text <=> process_name_text; }
                    Button { text: "Review termination"; clicked => { confirm_termination = true; } }
                }
                if confirm_termination: Rectangle { background: #382b22; border-radius: 8px; padding: 12px; VerticalLayout { spacing: 8px;
                    Text { text: "Confirm termination of PID " + process_pid_text + " (" + process_name_text + ")? Unsaved work in that process may be lost."; color: #ffe0bf; }
                    HorizontalLayout { spacing: 8px;
                        Button { text: "Confirm and terminate"; clicked => { terminate-process-requested(process_pid_text, process_name_text); confirm_termination = false; } }
                        Button { text: "Cancel"; clicked => { confirm_termination = false; } }
                    }
                } }
                Text { text: "Top processes by memory usage"; color: #9fb0c4; font-size: 12px; }
                Text { text: top_processes; color: #d6e0eb; font-size: 13px; }
            } }
            if active_page == 3: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px;
                Text { text: "Windows services · " + service_count; color: #f0f4f9; font-size: 18px; font-weight: 700; } LineEdit { width: 320px; placeholder-text: "Filter services by name/state"; text <=> service_filter; edited => { service-filter-requested(service_filter); } }
                Text { text: "Enter the exact service Name (not Display Name). Core Windows services are blocked. Changes are journaled and verified."; color: #9fb0c4; font-size: 12px; }
                HorizontalLayout { spacing: 8px;
                    LineEdit { width: 220px; placeholder-text: "Service name e.g. Spooler"; text <=> service_name_text; }
                    Button { text: "Start"; clicked => { service_action_start = true; confirm_service_action = true; } }
                    Button { text: "Stop"; clicked => { service_action_start = false; confirm_service_action = true; } }
                    Button { text: "Set Manual"; clicked => { service_start_mode = "Manual"; confirm_service_mode = true; } }
                    Button { text: "Set Automatic"; clicked => { service_start_mode = "Automatic"; confirm_service_mode = true; } }
                }
                if confirm_service_mode: Rectangle { background: #382b22; border-radius: 8px; padding: 10px; VerticalLayout { spacing: 8px;
                    Text { text: "Set '" + service_name_text + "' startup mode to " + service_start_mode + "? Disabled mode is intentionally unavailable."; color: #ffe0bf; }
                    HorizontalLayout { spacing: 8px;
                        Button { text: "Confirm startup mode"; clicked => { service-start-mode-requested(service_name_text, service_start_mode); confirm_service_mode = false; } }
                        Button { text: "Cancel"; clicked => { confirm_service_mode = false; } }
                    }
                } }
                if confirm_service_action: Rectangle { background: #382b22; border-radius: 8px; padding: 10px; VerticalLayout { spacing: 8px;
                    Text { text: "Confirm " + (service_action_start ? "starting" : "stopping") + " service '" + service_name_text + "'?"; color: #ffe0bf; }
                    HorizontalLayout { spacing: 8px;
                        Button { text: "Confirm action"; clicked => { service-action-requested(service_name_text, service_action_start); confirm_service_action = false; } }
                        Button { text: "Cancel"; clicked => { confirm_service_action = false; } }
                    }
                } }
                Text { text: service_items; color: #d6e0eb; font-size: 11px; }
            } }
            if active_page == 4: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: "Startup entries · " + startup_count; color: #f0f4f9; font-size: 18px; font-weight: 700; }
                Text { text: "Removal is limited to current-user Run/RunOnce values or files in the current-user Startup folder. A backup is created before removal."; color: #9fb0c4; font-size: 12px; }
                LineEdit { width: 320px; placeholder-text: "Filter Startup inventory (type to search)"; text <=> startup_filter; edited => { startup-filter-requested(startup_filter); } }
                LineEdit { width: 320px; placeholder-text: "Exact value name or Startup file name"; text <=> startup_entry_name; }
                HorizontalLayout { spacing: 8px;
                    Button { text: "Remove Run registry value"; clicked => { startup_remove_registry = true; confirm_startup_remove = true; } }
                    Button { text: "Remove Startup folder file"; clicked => { startup_remove_registry = false; confirm_startup_remove = true; } }
                }
                if confirm_startup_remove: Rectangle { background: #382b22; border-radius: 8px; padding: 10px; VerticalLayout { spacing: 8px;
                    Text { text: "Confirm removal of '" + startup_entry_name + "'? WinForge will back it up first."; color: #ffe0bf; }
                    HorizontalLayout { spacing: 8px;
                        Button { text: "Confirm backup and removal"; clicked => { startup-remove-requested(startup_entry_name, startup_remove_registry); confirm_startup_remove = false; } }
                        Button { text: "Cancel"; clicked => { confirm_startup_remove = false; } }
                    }
                } }
                HorizontalLayout { spacing: 8px;
                    LineEdit { width: 260px; placeholder-text: "Exact backup file name"; text <=> startup_backup_name; }
                    Button { text: "Restore Startup file backup"; clicked => { startup-restore-requested(startup_backup_name); } }
                    Button { text: "Restore Registry backup"; clicked => { startup-registry-restore-requested(startup_backup_name); } }
                }
                Text { text: startup_items; color: #d6e0eb; font-size: 12px; }
            } }
            if active_page == 5: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: "Network configuration"; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "Read-only ipconfig inventory. Diagnostics perform ping and DNS lookup; DNS flush clears only the resolver cache."; color: #9fb0c4; font-size: 12px; }
                Button { text: "Run connectivity diagnostics"; clicked => { network-diagnostics-requested(); } } Button { text: "Flush DNS cache"; clicked => { confirm_dns_flush = true; } } if confirm_dns_flush: Rectangle { background: #382b22; border-radius: 8px; padding: 10px; VerticalLayout { spacing: 8px; Text { text: "Confirm flushing the local DNS cache?"; color: #ffe0bf; } HorizontalLayout { spacing: 8px; Button { text: "Confirm flush"; clicked => { network-flush-dns-requested(); confirm_dns_flush = false; } } Button { text: "Cancel"; clicked => { confirm_dns_flush = false; } } } } } Text { text: network_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 6: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: "Storage overview"; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "Physical disks and volumes · Read-only"; color: #9fb0c4; font-size: 12px; } Text { text: storage_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 7: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: apps_count; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "Inventory from uninstall registry entries · exact-name uninstall confirmation; no quiet switches"; color: #9fb0c4; font-size: 12px; }
                LineEdit { width: 320px; placeholder-text: "Filter installed apps"; text <=> apps_filter; edited => { app-filter-requested(apps_filter); } } HorizontalLayout { spacing: 8px; LineEdit { width: 300px; placeholder-text: "Exact application DisplayName"; text <=> app_uninstall_name; } Button { text: "Review uninstall"; clicked => { confirm_app_uninstall = true; } } } if confirm_app_uninstall: Rectangle { background: #382b22; border-radius: 8px; padding: 10px; VerticalLayout { spacing: 8px; Text { text: "Launch the registered uninstaller for exactly \"" + app_uninstall_name + "\"? The app may remove data. WinForge will not add silent flags."; color: #ffe0bf; } HorizontalLayout { spacing: 8px; Button { text: "Confirm and launch uninstaller"; clicked => { app-uninstall-requested(app_uninstall_name); confirm_app_uninstall = false; } } Button { text: "Cancel"; clicked => { confirm_app_uninstall = false; } } } } } Text { text: apps_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 8: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: drivers_count; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "PnP signed driver inventory · Read-only"; color: #9fb0c4; font-size: 12px; } Text { text: drivers_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 9: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: tasks_count; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "Windows Task Scheduler inventory · Read-only"; color: #9fb0c4; font-size: 12px; } Text { text: tasks_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 10: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: events_count; color: #f0f4f9; font-size: 18px; } Text { text: "Recent System event warnings, errors and critical events · Read-only"; color: #9fb0c4; font-size: 12px; } Text { text: events_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 11: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: updates_count; color: #f0f4f9; font-size: 18px; } Text { text: "Installed hotfix inventory · Does not install or remove updates"; color: #9fb0c4; font-size: 12px; } Text { text: updates_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 12: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: firewall_count; color: #f0f4f9; font-size: 18px; } Text { text: "Firewall profile settings and enabled rules · Read-only"; color: #9fb0c4; font-size: 12px; } Text { text: firewall_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 13: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: restore_count; color: #f0f4f9; font-size: 18px; } Text { text: "Restore point inventory and manual checkpoint creation. Windows may require running WinForge as Administrator."; color: #9fb0c4; font-size: 12px; }
                HorizontalLayout { spacing: 8px; LineEdit { width: 300px; text <=> restore_description; placeholder-text: "Restore point description"; } Button { text: "Create restore point"; clicked => { confirm_restore_create = true; } } }
                if confirm_restore_create: Rectangle { background: #382b22; border-radius: 8px; padding: 10px; VerticalLayout { spacing: 8px; Text { text: "Create a Windows System Restore Point named \"" + restore_description + "\"? This can fail if System Protection is disabled or permission is insufficient."; color: #ffe0bf; } HorizontalLayout { spacing: 8px; Button { text: "Confirm create"; clicked => { restore-point-create-requested(restore_description); confirm_restore_create = false; } } Button { text: "Cancel"; clicked => { confirm_restore_create = false; } } } } } Text { text: restore_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 14: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: environment_count; color: #f0f4f9; font-size: 18px; } Text { text: "Current process environment variables · Values may contain private paths or tokens"; color: #9fb0c4; font-size: 12px; } Text { text: environment_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 15: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: security_count; color: #f0f4f9; font-size: 18px; } Text { text: "Defender, Firewall and UAC status · Read-only checks"; color: #9fb0c4; font-size: 12px; } Text { text: security_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 16: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: battery_count; color: #f0f4f9; font-size: 18px; } Text { text: "Battery presence and reported charge/capacity · Hardware dependent"; color: #9fb0c4; font-size: 12px; } Text { text: battery_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 17: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: activation_count; color: #f0f4f9; font-size: 18px; } Text { text: "Windows licensing status · Only partial product-key suffix is queried"; color: #9fb0c4; font-size: 12px; } Text { text: activation_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 18: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: adapter_count; color: #f0f4f9; font-size: 18px; } Text { text: "Physical and virtual network adapter inventory · Read-only"; color: #9fb0c4; font-size: 12px; } Text { text: adapter_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 19: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: boot_count; color: #f0f4f9; font-size: 18px; } Text { text: "Current Windows boot entry · Read-only BCDEdit query"; color: #9fb0c4; font-size: 12px; } Text { text: boot_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 20: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: power_count; color: #f0f4f9; font-size: 18px; } Text { text: "Installed schemes. Activation is reversible and requires confirmation."; color: #9fb0c4; font-size: 12px; } HorizontalLayout { spacing: 8px; Button { text: "Balanced"; clicked => { confirm_power_scheme = "381b4222-f694-41f0-9685-ff5bb260df2e"; } } Button { text: "Power Saver"; clicked => { confirm_power_scheme = "a1841308-3541-4fab-bc81-f71556f20b4a"; } } Button { text: "High Performance"; clicked => { confirm_power_scheme = "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c"; } } } if confirm_power_scheme != "" : Rectangle { background: #382b22; border-radius: 8px; padding: 10px; VerticalLayout { spacing: 8px; Text { text: "Activate power plan " + confirm_power_scheme + "?"; color: #ffe0bf; } HorizontalLayout { spacing: 8px; Button { text: "Confirm"; clicked => { power-scheme-requested(confirm_power_scheme); confirm_power_scheme = ""; } } Button { text: "Cancel"; clicked => { confirm_power_scheme = ""; } } } } } Text { text: power_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 21: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: device_health_count; color: #f0f4f9; font-size: 18px; } Text { text: "Plug and Play devices reporting non-zero problem codes · Read-only"; color: #9fb0c4; font-size: 12px; } Text { text: device_health_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 22: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: hardware_count; color: #f0f4f9; font-size: 18px; } Text { text: "System, motherboard, BIOS and graphics adapter inventory · Read-only"; color: #9fb0c4; font-size: 12px; } Text { text: hardware_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 23: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: privacy_count; color: #f0f4f9; font-size: 18px; } Text { text: "Windows privacy policy and app-consent indicators · Read-only; not a complete audit"; color: #9fb0c4; font-size: 12px; } Text { text: privacy_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 24: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 20px; spacing: 12px; Text { text: "WinForge Studio settings & safety"; color: #f0f4f9; font-size: 20px; font-weight: 700; } Text { text: "Current preview is inspection-only. No system settings are changed by Refresh."; color: #9fb0c4; font-size: 13px; } Text { text: "Privacy"; color: #80b5ef; font-size: 15px; font-weight: 700; } Text { text: "• Inventory queries run locally.\n• No telemetry or inventory upload.\n• Secret-like environment values are masked.\n• Hardware serial numbers are not collected."; color: #d6e0eb; font-size: 12px; } Text { text: "Safety"; color: #80b5ef; font-size: 15px; font-weight: 700; } Text { text: "• No automatic elevation. No service, startup, firewall, power, boot or update changes. Future changes require preview, confirmation, backup, journal and recovery."; color: #d6e0eb; font-size: 12px; } Text { text: "Refresh"; color: #80b5ef; font-size: 15px; font-weight: 700; } Text { text: "Use Refresh to rerun the read-only inventory. A second scan is ignored while one is running."; color: #d6e0eb; font-size: 12px; } } }
            if active_page == 27: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: "Local action journal"; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "History is stored locally in Documents/WinForge Studio/Journal/actions.log. Entries are review-only; this screen does not undo operations."; color: #9fb0c4; font-size: 12px; } Button { text: "Refresh history"; clicked => { action-history-refresh-requested(); } } Text { text: action_history_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 26: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: "Read-only system integrity checks"; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "DISM CheckHealth and SFC /verifyonly may take time. They inspect Windows; no repair or file replacement is performed."; color: #9fb0c4; font-size: 12px; } Button { text: "Run diagnostics"; clicked => { health-diagnostics-requested(); } } Text { text: health_diagnostics_items; color: #d6e0eb; font-size: 11px; } } }
            if active_page == 25: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 18px; spacing: 10px; Text { text: cleanup_count; color: #f0f4f9; font-size: 18px; font-weight: 700; } Text { text: "Preview scans temp locations. Cleanup deletes only current-user TEMP files older than 7 days; reparse points are skipped."; color: #9fb0c4; font-size: 12px; }
                Button { text: "Clean stale user temp files (7+ days)"; clicked => { confirm_cleanup = true; } }\n                if confirm_cleanup: Rectangle { background: #382b22; border-radius: 8px; padding: 10px; VerticalLayout { spacing: 8px; Text { text: "This permanently deletes regular files in your TEMP folder older than 7 days. Locked files are skipped. Continue?"; color: #ffe0bf; } HorizontalLayout { spacing: 8px; Button { text: "Confirm cleanup"; clicked => { cleanup-requested(); confirm_cleanup = false; } } Button { text: "Cancel"; clicked => { confirm_cleanup = false; } } } } } Text { text: cleanup_items; color: #d6e0eb; font-size: 12px; } } }

            if active_page > 27: Rectangle { border-radius: 10px; background: #1a222d; VerticalLayout { padding: 24px; spacing: 12px; Text { text: "Coming soon"; color: #edf3fa; font-size: 18px; font-weight: 700; } Text { text: "This module will be implemented with safety checks and restore support."; color: #9fb0c4; font-size: 13px; } Button { text: "Back to Dashboard"; clicked => { active_page = 0; } } } }
                }
            }
            Text { text: "NATIVE WINDOWS APP · RUST / SLINT"; color: #697b91; font-size: 10px; }
        }
    }
}

<Window x:Class="WinForgeStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WinForge Studio" Height="850" Width="1450" MinHeight="700" MinWidth="1100"
 Background="#10141D" WindowStartupLocation="CenterScreen">
 <Grid Margin="18">
  <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#151B26" CornerRadius="14" Padding="15" Margin="0,0,14,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="WINFORGE" FontSize="22" FontWeight="Bold" Foreground="#55C2A5"/>
     <TextBlock Text="STUDIO  •  LIVE EDITION" FontSize="10" Foreground="#9AA8BA" Margin="0,3,0,22"/>
     <Button Content="Overview / نمای کلی" Click="Overview_Click"/>
     <Button Content="Services / سرویس‌ها" Click="Services_Click"/>
     <Button Content="Processes / پردازش‌ها" Click="Processes_Click"/>
     <Button Content="Startup / شروع ویندوز" Click="Startup_Click"/>
     <Button Content="Change Journal / گزارش تغییرات" Click="Journal_Click"/>
     <Button Content="Settings / تنظیمات" Click="Settings_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="SAFE MODE" Foreground="#55C2A5" FontWeight="Bold"/>
     <TextBlock Text="Read-only scan by default" Foreground="#9AA8BA" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock Text="WinForge Studio • v0.1.0" Foreground="#65758A" FontSize="10" Margin="0,12,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,14">
    <StackPanel>
     <TextBlock x:Name="PageTitle" Text="System Overview" FontSize="25" FontWeight="SemiBold"/>
     <TextBlock Text="Inspect first. Understand risk. Apply only approved changes." Foreground="#9AA8BA" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <ComboBox x:Name="LanguageBox" Width="85" SelectedIndex="0" SelectionChanged="Language_Changed" Margin="4">
      <ComboBoxItem Content="EN"/><ComboBoxItem Content="FA"/>
     </ComboBox>
     <Button Content="Export report" Click="Export_Click" Margin="4"/><Button Content="↻ Scan system" Click="Refresh_Click" Background="#245A50"/>
    </StackPanel>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="OverviewPanel">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <UniformGrid Columns="4" Margin="0,0,0,12">
        <Border Background="#191F2B" CornerRadius="10" Padding="14" Margin="3"><StackPanel><TextBlock Text="Windows" Foreground="#9AA8BA"/><TextBlock x:Name="WindowsValue" Text="—" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Background="#191F2B" CornerRadius="10" Padding="14" Margin="3"><StackPanel><TextBlock Text="RAM used / total" Foreground="#9AA8BA"/><TextBlock x:Name="RamValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Background="#191F2B" CornerRadius="10" Padding="14" Margin="3"><StackPanel><TextBlock Text="CPU threads" Foreground="#9AA8BA"/><TextBlock x:Name="CpuValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Background="#191F2B" CornerRadius="10" Padding="14" Margin="3"><StackPanel><TextBlock Text="System drive free" Foreground="#9AA8BA"/><TextBlock x:Name="DiskValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
       </UniformGrid>
       <Border Background="#191F2B" CornerRadius="10" Padding="18">
        <StackPanel>
         <TextBlock Text="System details / جزئیات سیستم" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <TextBlock x:Name="DetailsValue" Foreground="#C2CCDA" TextWrapping="Wrap" LineHeight="25"/>
         <TextBlock Text="Read-only scan. Service changes require confirmation and are recorded locally." Foreground="#55C2A5" TextWrapping="Wrap" Margin="0,18,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid x:Name="ServicesPanel" Visibility="Collapsed">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
       <TextBox x:Name="ServiceSearch" Width="300" Height="32" VerticalContentAlignment="Center" TextChanged="Search_Changed"/>
       <Button Content="Start selected" Click="StartService_Click"/><Button Content="Stop selected" Click="StopService_Click" Background="#70413F"/><Button Content="Set Manual" Click="Manual_Click"/>
       <Button Content="Set Automatic" Click="Automatic_Click"/>
       <Button Content="Disable" Click="Disable_Click" Background="#70413F"/>
      </StackPanel>
      <DataGrid x:Name="ServicesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
       Background="#191F2B" Foreground="#EAF0F7" RowBackground="#191F2B" AlternatingRowBackground="#202938"
       GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Service" Binding="{Binding DisplayName}" Width="2*"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*"/>
        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="*"/>
        <DataGridTextColumn Header="Startup" Binding="{Binding StartType}" Width="*"/>
        <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="*"/>
        <DataGridTextColumn Header="Risk explanation" Binding="{Binding RiskReason}" Width="3*"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Grid>
    <Grid x:Name="ProcessesPanel" Visibility="Collapsed">
     <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><TextBox x:Name="ProcessSearch" Width="280" Height="32" VerticalContentAlignment="Center" TextChanged="ProcessSearch_Changed" ToolTip="Filter by name, PID or executable path"/><Button Content="End selected process" Click="EndProcess_Click" Background="#70413F"/><Button Content="Refresh list" Click="Refresh_Click"/></StackPanel><DataGrid x:Name="ProcessesGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#191F2B" Foreground="#EAF0F7" RowBackground="#191F2B" AlternatingRowBackground="#202938" BorderThickness="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="*"/>
       <DataGridTextColumn Header="Memory MB" Binding="{Binding MemoryMb, StringFormat=N1}" Width="*"/>
       <DataGridTextColumn Header="CPU time (s)" Binding="{Binding CpuSeconds, StringFormat=N1}" Width="*"/>
       <DataGridTextColumn Header="Executable path" Binding="{Binding FilePath}" Width="4*"/>
      </DataGrid.Columns>
     </DataGrid></DockPanel>
    </Grid>
    <Grid x:Name="StartupPanel" Visibility="Collapsed">
     <DockPanel><TextBox DockPanel.Dock="Top" x:Name="StartupSearch" Width="320" Height="32" HorizontalAlignment="Left" Margin="0,0,0,8" VerticalContentAlignment="Center" TextChanged="StartupSearch_Changed" ToolTip="Filter startup entries"/><Button DockPanel.Dock="Top" Content="Remove selected entry" Click="RemoveStartup_Click" Background="#70413F" Margin="0,0,0,8"/><DataGrid x:Name="StartupGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#191F2B" Foreground="#EAF0F7" RowBackground="#191F2B" AlternatingRowBackground="#202938" BorderThickness="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Entry" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
       <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="4*"/>
       <DataGridTextColumn Header="Review" Binding="{Binding Risk}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid></DockPanel>
    </Grid>
    <Grid x:Name="JournalPanel" Visibility="Collapsed">
     <StackPanel>
      <TextBlock Text="Change journal" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="JournalPathText" TextWrapping="Wrap" Foreground="#9AA8BA" Margin="0,10"/>
      <TextBlock Text="Append-only JSONL audit log. It is not an automatic rollback engine." Foreground="#C2CCDA" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
     <StackPanel>
      <TextBlock Text="Settings / تنظیمات" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="The initial shell provides bilingual labels; full Persian RTL localization is not complete yet." TextWrapping="Wrap" Foreground="#C2CCDA" Margin="0,12"/>
      <TextBlock Text="No background service, telemetry, scheduled task, or automatic optimization is installed." Foreground="#55C2A5"/>
     </StackPanel>
    </Grid>
   </Grid>
   <Border Grid.Row="2" Background="#191F2B" CornerRadius="8" Padding="10" Margin="0,12,0,0">
    <TextBlock x:Name="StatusText" Text="Ready • Scan to inspect this PC" Foreground="#9AA8BA"/>
   </Border>
  </Grid>
 </Grid>
</Window>

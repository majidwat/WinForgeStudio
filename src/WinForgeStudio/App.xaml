<Application x:Class="WinForgeStudio.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#10141D"/>
  <SolidColorBrush x:Key="Panel" Color="#191F2B"/>
  <SolidColorBrush x:Key="Accent" Color="#55C2A5"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="Background" Value="#2A394A"/>
   <Setter Property="BorderBrush" Value="#3B4C60"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
  </Style>
 </Application.Resources>
</Application>
